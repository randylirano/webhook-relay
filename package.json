{
  "name": "webhook-relay",
  "version": "0.1.0",
  "private": true,
  "description": "Outbound webhook relay (NestJS, PostgreSQL SKIP LOCKED queue): HMAC-signed payloads, backoff retries, DLQ, replay",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "db:up": "docker compose up -d postgres",
    "migrate": "node-pg-migrate up -m src/migrations",
    "migrate:down": "node-pg-migrate down -m src/migrations",
    "migrate:create": "node-pg-migrate create -m src/migrations -j sql",
    "seed": "echo 'seed: not implemented yet (build plan step 11)'",
    "test": "jest -c test/jest.config.js",
    "test:race": "jest -c test/jest.race.config.js",
    "bench": "k6 run bench/ingest.js",
    "lint": "eslint . && tsc --noEmit -p tsconfig.json",
    "format": "prettier --write .",
    "verify": "bun run lint && bun run test && bun run test:race",
    "demo": "DEMO_MODE=true nest start"
  },
  "dependencies": {
    "@nestjs/common": "^11",
    "@nestjs/core": "^11",
    "@nestjs/platform-express": "^11",
    "@nestjs/swagger": "^11",
    "dotenv": "^18.0.10",
    "nestjs-pino": "^5.3.2",
    "node-pg-migrate": "^9.0.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^11",
    "@nestjs/schematics": "^11",
    "@nestjs/testing": "^11",
    "@testcontainers/postgresql": "^12.2.2",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^24",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "fast-check": "^4.11.0",
    "jest": "^30.5.2",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.10.1",
    "supertest": "^7.3.2",
    "testcontainers": "^12.2.2",
    "ts-jest": "^29.4.15",
    "typescript": "~6.0",
    "typescript-eslint": "^8.73.0"
  }
}
